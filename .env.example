# Copy this file to .env and fill it in. .env is ignored by git, so keys never reach GitHub.

# Required — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — a free backup for screen reading and web search when Gemini's quota runs out.
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional — only for email_mode "imap", when Gmail is not connected from the dashboard.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Optional — a different thinking brain for typed chats, jobs and hard questions
# ("brain" in config.json: gemini, claude or openrouter). Voice always uses Gemini.
# Claude also needs: .venv/bin/pip install anthropic   (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Any model OpenRouter serves — GPT, Grok, Llama... (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional — talk to David from your phone. Make a bot with @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Your own Telegram id. Leave empty, message the bot once, and it tells you.
TELEGRAM_OWNER_ID=
